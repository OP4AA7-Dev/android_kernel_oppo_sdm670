# DTBO
CONFIG_BUILD_ARM64_DT_OVERLAY=y

# Fingerprint
CONFIG_OPPO_FINGERPRINT_GOODIX_OPTICAL=y
CONFIG_OPPO_FINGERPRINT_SILEAD_OPTICAL=y

# Haptics
CONFIG_TOUCHSCREEN_SYNAPTICS=y
CONFIG_TOUCHSCREEN_SYNAPTICS_S3706=y

# Platform
CONFIG_MACH_OPLUS_PBEM00=y

# Ramdisk
CONFIG_INITRAMFS_IGNORE_SKIP_FLAG=y